# Alibaba Cloud Model Studio API Configuration
# Copy this file to .env_alibaba and fill in your actual API key

# Alibaba Cloud API Key (official environment variable name from documentation)
DASHSCOPE_API_KEY=your_alibaba_api_key_here

# Alternative variable name (also supported)
ALIBABA_API_KEY=your_alibaba_api_key_here
DASHSCOPE_API_KEY=your_alibaba_api_key_here
ALIBABA_REGION=singapore

# Model Configuration
ALIBABA_MODEL=qwen-vl-ocr

# Generation Parameters
ALIBABA_TEMPERATURE=1.0
ALIBABA_TOP_P=0.8
ALIBABA_TOP_K=

# Image Processing Parameters (according to Alibaba Cloud documentation)
# min_pixels: Ensures small images are enlarged to recognize details (minimum: 65536)
ALIBABA_MIN_PIXELS=65536

# max_pixels: Prevents oversized images from consuming excessive resources (default: 6422528)
ALIBABA_MAX_PIXELS=6422528

# Instructions:
# 1. Replace API keys with your actual keys
# 2. Keep this file secure and never commit it to version control
# 3. Get your API key from: https://dashscope.console.aliyun.com/
# 4. API keys for Singapore and China regions are different
# 5. Documentation: https://www.alibabacloud.com/help/en/model-studio/use-qwen-by-calling-api
# 6. File size limit: 10MB per image
# 7. Pixel limits: min_pixels=3136, max_pixels=6422528 (default values)
