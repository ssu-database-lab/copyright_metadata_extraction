# Copy this file to .env and fill in your keys
# ============================================

# --- Alibaba Cloud / DashScope ---
DASHSCOPE_API_KEY=your_dashscope_api_key_here
ALIBABA_API_KEY=your_dashscope_api_key_here
ALIBABA_REGION=singapore

# Alibaba OCR model parameters
ALIBABA_MODEL=qwen3-vl-235b-a22b-instruct
ALIBABA_TEMPERATURE=1.0
ALIBABA_TOP_P=0.8
ALIBABA_TOP_K=
ALIBABA_MIN_PIXELS=65536
ALIBABA_MAX_PIXELS=6422528

# --- Mistral OCR ---
MISTRAL_API_KEY=your_mistral_api_key_here

# --- Google Vision OCR ---
# GOOGLE_APPLICATION_CREDENTIALS=api/google_credentials.json

# --- Naver CLOVA OCR ---
# NAVER_OCR_API_URL=your_naver_ocr_url_here
# NAVER_OCR_SECRET_KEY=your_naver_secret_key_here

# --- WSL2 fix for Google API IPv6 ---
GRPC_DNS_RESOLVER=native
